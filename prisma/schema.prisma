datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Channel {
  id                String   @id @default(uuid())
  youtubeChannelId  String   @unique
  name              String
  handle            String?
  thumbnailUrl      String
  subscriberCount   Int?     @default(0)
  totalViews        BigInt?  @default(0)
  videoCount        Int?     @default(0)
  medianViews       Int?     @default(0)
  category          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  videos            Video[]
  tracked           TrackedChannel?

  @@index([youtubeChannelId])
  @@index([name])
}

model Video {
  id                 String   @id @default(uuid())
  youtubeVideoId     String   @unique
  channelId          String
  title              String
  description        String?  @db.Text
  thumbnailUrl       String
  publishedAt        DateTime
  viewCount          BigInt   @default(0)
  likeCount          Int?     @default(0)
  commentCount       Int?     @default(0)
  durationFormatted  String?
  durationSeconds    Int?     @default(0)
  isShort            Boolean  @default(false)
  
  // Outlier & Growth Intelligence
  outlierMultiplier  Float?   @default(1.0)
  viralBreakoutScore Float?   @default(0.0)
  viewsPerDay        Float?   @default(0.0)
  titlePattern       String?
  category           String?
  niche              String?
  subNiche           String?
  
  analyzedAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  channel            Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([youtubeVideoId])
  @@index([publishedAt])
  @@index([outlierMultiplier])
  @@index([viralBreakoutScore])
  @@index([isShort])
  @@index([category])
}

model Folder {
  id          String   @id @default(uuid())
  name        String
  color       String?  @default("blue")
  description String?
  createdAt   DateTime @default(now())

  trackedChannels TrackedChannel[]
}

model TrackedChannel {
  id             String    @id @default(uuid())
  channelId      String    @unique
  name           String
  handle         String?
  avatar         String
  subscribers    Int       @default(0)
  totalViews     BigInt    @default(0)
  videoCount     Int       @default(0)
  folderId       String?
  tags           String[]  @default([])
  notes          String?
  baselineViews  Int       @default(1000)
  lastCheckedAt  DateTime  @default(now())
  addedAt        DateTime  @default(now())

  channel        Channel?  @relation(fields: [channelId], references: [youtubeChannelId], onDelete: Cascade)
  folder         Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([folderId])
}

model ChannelAlert {
  id                String   @id @default(uuid())
  channelId         String
  channelName       String
  channelAvatar     String
  videoId           String
  videoTitle        String
  videoThumbnail    String
  publishedAt       DateTime
  views             BigInt
  baselineViews     Int
  outlierMultiplier Float
  alertType         String   // breakout_video, high_velocity, etc.
  severity          String   @default("info")
  message           String
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([channelId])
  @@index([isRead])
  @@index([createdAt])
}
